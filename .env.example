# Pflichtangabe – mindestens 48 zufällige Hex-Zeichen
# Erzeugen: python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS

# Datenspeicher (Standard: ./data)
DATA_DIR=/var/lib/verbandbuch

# Setzt "Secure"-Flag auf Session-Cookie (1 bei HTTPS, 0 intern ohne TLS)
SECURE_COOKIES=1

# Öffentliche Basis-URL der App (für Admin-Links in Teams-Benachrichtigungen)
PUBLIC_BASE_URL=https://your-domain.example

# Optional: Microsoft Teams Incoming Webhook URL
# Es werden KEINE Gesundheitsdaten übertragen – nur Eintrag-ID + Admin-Link.
# Leer lassen um Benachrichtigungen zu deaktivieren.
TEAMS_WEBHOOK_URL=
