# Pflichtangabe – mindestens 48 zufällige Hex-Zeichen
# Erzeugen: python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS

# Datenspeicher (Standard: ./data)
DATA_DIR=/var/lib/verbandbuch

# Setzt "Secure"-Flag auf Session-Cookie (1 bei HTTPS, 0 intern ohne TLS)
SECURE_COOKIES=1

# Öffentliche Basis-URL der App (für Admin-Links in Benachrichtigungen)
PUBLIC_BASE_URL=https://your-domain.example

# Benachrichtigung: none (aus), webhook oder smtp
# Es werden KEINE Gesundheitsdaten übertragen – nur Eintrag-ID + Admin-Link.
# Ohne NOTIFICATION_METHOD: webhook bei gesetzter Webhook-URL, sonst none.
NOTIFICATION_METHOD=none

# Webhook: Teams-kompatible MessageCard als JSON-POST; nur HTTPS verwenden.
WEBHOOK_URL=
# Bisheriger Name bleibt als Fallback für WEBHOOK_URL unterstützt.
TEAMS_WEBHOOK_URL=

# SMTP: SMTP_TO kann mehrere, durch Kommas getrennte Empfänger enthalten.
SMTP_HOST=
SMTP_PORT=587
# starttls (Standard, Port 587), ssl (üblicherweise 465), none (internes Relay).
# TLS prüft Serverzertifikate; Anmeldung ist nur mit TLS erlaubt.
SMTP_SECURITY=starttls
# Für ein Relay ohne Anmeldung beide Felder leer lassen.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=verbandbuch@example.com
SMTP_TO=arbeitsschutz@example.com

# Anzahl vertrauenswürdiger Proxy-Hops für X-Forwarded-For und X-Forwarded-Proto.
# Wirkt sich auf Rate-Limiting aus (falsche Einstellung → falsche Client-IP erkannt).
#
# Beispiele:
#   NPM → Gunicorn direkt:          PROXY_X_FOR=1  PROXY_X_PROTO=1
#   NPM → Apache → Gunicorn:        PROXY_X_FOR=2  PROXY_X_PROTO=1
#
# Voraussetzung: vorgelagerte Proxies überschreiben X-Forwarded-For kontrolliert,
# sodass Clients diesen Header nicht selbst setzen können.
PROXY_X_FOR=1
PROXY_X_PROTO=1
